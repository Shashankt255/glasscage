    {
      "id": "secret-patterns",
      "name": "Secret Detection Patterns",
      "source_file": "secret-patterns.md",
      "patterns": [
        {"name": "AWS_ACCESS_KEY", "severity": "critical", "category": "aws", "regex": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"},
        {"name": "AWS_SECRET_TYPED", "severity": "critical", "category": "aws", "regex": "(?i)aws[_\\-]?secret[_\\-]?access[_\\-]?key['\"]?\\s*[:=]\\s*['\"]?([A-Za-z0-9/+=]{40})"},
        {"name": "GCP_SERVICE_ACCOUNT", "severity": "critical", "category": "gcp", "regex": "\"type\"\\s*:\\s*\"service_account\""},
        {"name": "GOOGLE_API_KEY", "severity": "high", "category": "gcp", "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"},
        {"name": "GH_PAT_CLASSIC", "severity": "critical", "category": "github", "regex": "\\bghp_[A-Za-z0-9]{36}\\b"},
        {"name": "GH_PAT_FINEGRAINED", "severity": "critical", "category": "github", "regex": "\\bgithub_pat_[A-Za-z0-9_]{82}\\b"},
        {"name": "GH_OAUTH", "severity": "high", "category": "github", "regex": "\\bgho_[A-Za-z0-9]{36}\\b"},
        {"name": "GH_S2S", "severity": "high", "category": "github", "regex": "\\bgh[usr]_[A-Za-z0-9]{36,}\\b"},
        {"name": "STRIPE_LIVE", "severity": "critical", "category": "stripe", "regex": "\\bsk_live_[0-9A-Za-z]{24,}\\b"},
        {"name": "STRIPE_TEST", "severity": "low", "category": "stripe", "regex": "\\bsk_test_[0-9A-Za-z]{24,}\\b"},
        {"name": "SLACK_TOKEN", "severity": "high", "category": "slack", "regex": "\\bxox[abpors]-[0-9A-Za-z\\-]{10,48}\\b"},
        {"name": "SLACK_WEBHOOK", "severity": "medium", "category": "slack", "regex": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+"},
        {"name": "SENDGRID", "severity": "high", "category": "email_svc", "regex": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b"},
        {"name": "MAILGUN", "severity": "high", "category": "email_svc", "regex": "\\bkey-[0-9a-zA-Z]{32}\\b"},
        {"name": "TWILIO_API", "severity": "high", "category": "twilio", "regex": "\\bSK[0-9a-fA-F]{32}\\b"},
        {"name": "TWILIO_SID", "severity": "medium", "category": "twilio", "regex": "\\bAC[a-f0-9]{32}\\b"},
        {"name": "HEROKU_API", "severity": "medium", "category": "paas", "regex": "(?i)heroku(.{0,20})?api[\"'=: ]+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"},
        {"name": "FIREBASE_URL", "severity": "low", "category": "firebase", "regex": "\\bhttps?://[a-z0-9\\-]+\\.firebaseio\\.com\\b"},
        {"name": "JWT", "severity": "medium", "category": "jwt", "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\b"},
        {"name": "BEARER_AUTH", "severity": "medium", "category": "bearer", "regex": "(?i)authorization[\"'=: ]+bearer\\s+[A-Za-z0-9._\\-]{20,}"},
        {"name": "BASIC_AUTH_URL", "severity": "medium", "category": "basic_auth", "regex": "https?://[^/\\s:@]+:[^/\\s:@]+@[^/\\s]+"},
        {"name": "RSA_PRIVKEY", "severity": "critical", "category": "private_key", "regex": "-----BEGIN RSA PRIVATE KEY-----"},
        {"name": "EC_PRIVKEY", "severity": "critical", "category": "private_key", "regex": "-----BEGIN EC PRIVATE KEY-----"},
        {"name": "OPENSSH_PRIVKEY", "severity": "critical", "category": "private_key", "regex": "-----BEGIN OPENSSH PRIVATE KEY-----"},
        {"name": "GENERIC_PRIVKEY", "severity": "critical", "category": "private_key", "regex": "-----BEGIN (DSA |PGP |)PRIVATE KEY-----"},
        {"name": "GENERIC_API_KEY", "severity": "medium", "category": "generic", "regex": "(?i)(?:api[_\\-]?key|apikey|api_secret|access_token|secret[_\\-]?token)['\"]?\\s*[:=]\\s*[\"']([A-Za-z0-9+/=_\\-]{24,})[\"']"}
      ]
    },
